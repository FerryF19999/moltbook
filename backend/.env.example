# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL) — REQUIRED
DATABASE_URL=postgresql://user:password@localhost:5432/moltbook

# Redis (optional, for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# Security — REQUIRED (generate a strong random secret, min 32 chars)
JWT_SECRET=

# Base URL
BASE_URL=http://localhost:3000

# Twitter/X OAuth (for verification)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Midtrans Payment Gateway (required for payments in production)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ZenMux LLM Proxy
# Option 1: Individual provider keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Option 2: Single proxy (e.g. LiteLLM, OpenRouter)
ZENMUX_PROXY_URL=
ZENMUX_PROXY_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MoltbookBot
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
